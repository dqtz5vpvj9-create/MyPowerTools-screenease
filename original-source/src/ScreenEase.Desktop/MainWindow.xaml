<Window x:Class="ScreenEase.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenEase"
        Width="1040"
        Height="680"
        MinWidth="900"
        MinHeight="580"
        Background="#F3F6F8"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        Language="zh-CN"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        TextOptions.TextHintingMode="Auto">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#17201D" />
        <SolidColorBrush x:Key="MutedBrush" Color="#63716C" />
        <SolidColorBrush x:Key="SubtleBrush" Color="#F8FAFB" />
        <SolidColorBrush x:Key="ShellBrush" Color="#E9EFF2" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#D6E0E2" />
        <SolidColorBrush x:Key="AccentBrush" Color="#176B5B" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D7B69" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#E2F1EC" />
        <SolidColorBrush x:Key="AmberBrush" Color="#B46D1F" />

        <Style TargetType="{x:Type Control}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="TinyLabel" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Panel" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F4F8F7" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#A8C4BC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#EAF2EF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#125749" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="12,6" />
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Margin" Value="0,0,22,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box"
                                    Width="20"
                                    Height="20"
                                    CornerRadius="5"
                                    BorderThickness="1"
                                    BorderBrush="#9DAAA6"
                                    Background="#FFFFFF">
                                <TextBlock x:Name="Check"
                                           Text="✓"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="{TemplateBinding Background}"
                                Height="4"
                                CornerRadius="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Thumb}">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="#FFFFFF"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="2"
                                CornerRadius="9" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Slider}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                  Background="{StaticResource AccentBrush}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  Background="#D9E2E4" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="{x:Type ListBox}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="AccentMark"
                                        Width="4"
                                        CornerRadius="2"
                                        Background="Transparent" />
                                <ContentPresenter Grid.Column="1" Margin="12,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F6FAF8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#B6D9CE" />
                                <Setter TargetName="AccentMark" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#FFFFFF"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="26,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ScreenEase"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal"
                                Margin="16,2,0,0"
                                VerticalAlignment="Center">
                        <Ellipse Width="7"
                                 Height="7"
                                 Fill="{StaticResource AccentBrush}"
                                 Margin="0,0,7,0"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ConnectionSummary}"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding EffectSummary}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource ShellBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="18">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                        <TextBlock Text="模式" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding FilterStateText}"
                                   Margin="0,5,0,0"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>

                    <Button DockPanel.Dock="Bottom"
                            Content="{Binding FilterButtonText}"
                            Command="{Binding ToggleFilterCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,14,0,0"
                            Height="44" />

                    <ListBox x:Name="ProfilesList"
                             ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                             SelectionChanged="ProfilesList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1"
                                               Margin="0,3,0,0"
                                               FontSize="12"
                                               Foreground="{StaticResource MutedBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} K · {1}%">
                                                <Binding Path="ColorTemperatureKelvin" />
                                                <Binding Path="BrightnessPercent" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" FocusVisualStyle="{x:Null}">
                <StackPanel Margin="28,22">
                    <Border Background="{StaticResource AccentBrush}"
                            CornerRadius="8"
                            Padding="24"
                            Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding CurrentProfileName}"
                                           FontSize="30"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFF" />
                                <TextBlock Text="{Binding FilterStateText}"
                                           Margin="0,6,0,0"
                                           Foreground="#CDE4DD" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{Binding FilterButtonText}"
                                        Command="{Binding ToggleFilterCommand}"
                                        Background="#FFFFFF"
                                        BorderBrush="#FFFFFF"
                                        Foreground="{StaticResource AccentBrush}"
                                        MinWidth="118" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="护眼调节" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,18" />

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="78" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="色温" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1"
                                            Minimum="2500"
                                            Maximum="6500"
                                            TickFrequency="100"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding ColorTemperatureKelvin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding ColorTemperatureKelvin, StringFormat={}{0} K}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="78" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="亮度" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1"
                                            Minimum="10"
                                            Maximum="100"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding BrightnessPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding BrightnessPercent, StringFormat={}{0}%}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="模式名称" Style="{StaticResource TinyLabel}" Margin="0,0,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding ProfileNameDraft, UpdateSourceTrigger=PropertyChanged}"
                                                 MinWidth="160"
                                                 Margin="0,0,8,0" />
                                        <Button Grid.Column="1"
                                                Content="保存"
                                                Command="{Binding SaveProfileCommand}"
                                                MinWidth="70"
                                                Margin="0,0,8,0" />
                                        <Button Grid.Column="2"
                                                Content="新增"
                                                Command="{Binding AddProfileCommand}"
                                                MinWidth="70" />
                                    </Grid>
                                </StackPanel>

                                <Button Content="应用当前调节"
                                        Command="{Binding ApplyManualCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left"
                                        MinWidth="132" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="休息提醒" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,18" />
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="状态" Style="{StaticResource TinyLabel}" />
                                        <TextBlock Text="{Binding RestTimerPhaseText}" FontSize="20" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="剩余" Style="{StaticResource TinyLabel}" />
                                        <TextBlock Text="{Binding RestTimerRemainingText}" FontSize="20" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="次数" Style="{StaticResource TinyLabel}" />
                                        <TextBlock Text="{Binding CompletedWorkSessions}" FontSize="20" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                                <WrapPanel>
                                    <Button Content="开始" Command="{Binding StartTimerCommand}" Margin="0,0,8,8" />
                                    <Button Content="暂停" Command="{Binding PauseTimerCommand}" Margin="0,0,8,8" />
                                    <Button Content="继续" Command="{Binding ResumeTimerCommand}" Margin="0,0,8,8" />
                                    <Button Content="重置" Command="{Binding ResetTimerCommand}" Margin="0,0,0,8" />
                                </WrapPanel>

                                <Border Height="1"
                                        Background="{StaticResource LineBrush}"
                                        Margin="0,10,0,16" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Content="启用提醒"
                                              IsChecked="{Binding RestTimerEnabled, Mode=TwoWay}" />
                                    <CheckBox Grid.Column="1"
                                              Content="自动开始下一轮"
                                              IsChecked="{Binding RestTimerAutoStart, Mode=TwoWay}" />
                                </Grid>

                                <UniformGrid Columns="2" Margin="0,0,0,12">
                                    <StackPanel Margin="0,0,12,10">
                                        <TextBlock Text="专注分钟" Style="{StaticResource TinyLabel}" Margin="0,0,0,5" />
                                        <TextBox Text="{Binding RestTimerWorkMinutes, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="短休分钟" Style="{StaticResource TinyLabel}" Margin="0,0,0,5" />
                                        <TextBox Text="{Binding RestTimerShortBreakMinutes, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="长休分钟" Style="{StaticResource TinyLabel}" Margin="0,0,0,5" />
                                        <TextBox Text="{Binding RestTimerLongBreakMinutes, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="长休间隔" Style="{StaticResource TinyLabel}" Margin="0,0,0,5" />
                                        <TextBox Text="{Binding RestTimerLongBreakEveryWorkSessions, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>
                                </UniformGrid>

                                <Button Content="保存提醒设置"
                                        Command="{Binding SaveRestTimerSettingsCommand}"
                                        HorizontalAlignment="Left"
                                        MinWidth="118" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding ErrorText}"
                               Foreground="{StaticResource AmberBrush}"
                               Margin="2,0,0,12" />

                    <Expander Header="诊断" Margin="0,0,0,18">
                        <Border Style="{StaticResource Panel}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="服务地址" Style="{StaticResource TinyLabel}" />
                                <Grid Margin="0,6,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding ServiceUrl, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,10,0" />
                                    <Button Grid.Column="1"
                                            Content="连接"
                                            Command="{Binding RefreshCommand}" />
                                </Grid>

                                <TextBlock Text="显示器" Style="{StaticResource TinyLabel}" Margin="0,0,0,8" />
                                <ListView ItemsSource="{Binding Monitors}"
                                          MinHeight="96"
                                          BorderBrush="{StaticResource LineBrush}">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="设备" DisplayMemberBinding="{Binding Name}" Width="220" />
                                            <GridViewColumn Header="位置" DisplayMemberBinding="{Binding Bounds}" Width="220" />
                                            <GridViewColumn Header="主屏" DisplayMemberBinding="{Binding Primary}" Width="70" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
