{
  "id": "screenease.service",
  "toolId": "screenease",
  "displayName": "ScreenEase Service",
  "exec": "ScreenEase.Service.exe",
  "arguments": [
    "--pipe",
    "screenease.core",
    "--heartbeat-file",
    "%LOCALAPPDATA%/MyPowerTools/state/screenease.heartbeat"
  ],
  "workingDirectory": "",
  "environment": {
    "ScreenEase__Transport": "pipe",
    "ScreenEase__NamedPipe__Name": "screenease.core",
    "ScreenEase__Driver": "windows",
    "MPT_TOOL_DATA_ROOT": "%LOCALAPPDATA%/MyPowerTools/state/tools/screenease"
  },
  "autostart": true,
  "restartPolicy": { "maxRestarts": 5, "backoffMs": 2000 },
  "readiness": { "kind": "pipe", "address": "screenease.core", "timeoutMs": 8000 },
  "stopTimeoutMs": 5000,
  "dataRoots": [
    "%LOCALAPPDATA%/MyPowerTools/state/tools/screenease"
  ],
  "dependsOn": [],
  "instanceToken": "screenease-service-v1"
}
